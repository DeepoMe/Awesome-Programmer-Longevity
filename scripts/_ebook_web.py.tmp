# -*- coding: utf-8 -*-
"""ebook 生成器双语化 v3: 修正锚点"""
import pathlib

p = pathlib.Path(r'd:\00000___Coding\113--CapoVime\续命指南\awesome-programmer-longevity\scripts\_ebook_web.py')
t = p.read_text(encoding='utf-8')

old_read = 'md = (root / "README_ZH.md").read_text(encoding="utf-8")'
assert old_read in t, 'read 锚点缺失'
t = t.replace(old_read, '''LANG = __import__('sys').argv[1] if len(__import__('sys').argv) > 1 else 'zh'
if LANG == 'en':
    SRC_NAME, OUT_NAME, LANG_LINK = 'README.md', 'ebook.html', 'ebook-zh.html'
else:
    SRC_NAME, OUT_NAME, LANG_LINK = 'README_ZH.md', 'ebook-zh.html', 'ebook.html'
md = (root / SRC_NAME).read_text(encoding="utf-8")''')

old_out = 'out = root / "ebook.html"'
assert old_out in t
t = t.replace(old_out, 'out = root / OUT_NAME')

# header 按钮组: 在 🌙 按钮后加语言切换
old_hdr = '<button onclick="night()">🌙</button>'
assert old_hdr in t
t = t.replace(old_hdr, old_hdr + '\n<button onclick="location.href=\'__LANG__\'">A/文</button>', 1)

# 生成组装: 注入 LANG_LINK
old_html = 'html = HTML.replace("__SECTIONS__"'
assert old_html in t
t = t.replace(old_html, 'html = HTML.replace("__LANG__", LANG_LINK).replace("__SECTIONS__"', 1)

# 封面提示
t = t.replace('👉 点击屏幕左右侧翻页｜滑动也可以｜每节参考文献在节末折叠条里，点击展开',
              '👉 点击左右侧翻页｜滑动也可以｜顶部 A/文 切换语言｜参考文献在节末折叠条')

p.write_text(t, encoding='utf-8')
print('v3 注入完成')
